# Stoned Goose Hub — environment.
# Copy to infra/.env and fill in the secrets.

# ===========================================================================
# Phase A — Twenty
# ===========================================================================

# Pin to a Twenty release tag. Bump deliberately (see docs/runbook.md).
TAG=v2.8.3

# Where the app is reachable from the browser. For local dev, leave as-is.
SERVER_URL=http://localhost:3000

# Postgres credentials (used by both `server` and `db` services).
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=change_me_strong_password_no_special_chars

# Secrets — generate each with:  openssl rand -base64 32
# Losing ENCRYPTION_KEY makes existing data unrecoverable. Back it up.
ENCRYPTION_KEY=
APP_SECRET=

# Storage backend for uploads.
STORAGE_TYPE=local

# ===========================================================================
# Phase B — Cal.com (scheduling, http://localhost:3001)
# ===========================================================================

CALCOM_TAG=v6.2.0
CALCOM_WEBAPP_URL=http://localhost:3001
CALCOM_DB_PASSWORD=change_me_calcom_db

# Generate each with:  openssl rand -base64 32
CALCOM_NEXTAUTH_SECRET=
# CALENDSO_ENCRYPTION_KEY must be exactly 32 bytes hex. Generate with:
#   openssl rand -hex 32
CALCOM_ENCRYPTION_KEY=

# ===========================================================================
# Phase B — Documenso (e-signature, http://localhost:3002)
# ===========================================================================

DOCUMENSO_TAG=v2.11.0
DOCUMENSO_WEBAPP_URL=http://localhost:3002
DOCUMENSO_DB_PASSWORD=change_me_documenso_db

# Generate each with:  openssl rand -base64 32
DOCUMENSO_NEXTAUTH_SECRET=
DOCUMENSO_ENCRYPTION_KEY=
DOCUMENSO_ENCRYPTION_SECONDARY_KEY=

# Outbound mail goes to Mailpit (http://localhost:8025) in local dev.
# To send real email, point these at your real SMTP provider.
DOCUMENSO_FROM_NAME=Stoned Goose Hub
DOCUMENSO_FROM_ADDRESS=no-reply@stonedgoose.local

# Documenso requires a code-signing .p12 cert mounted at infra/documenso-cert/cert.p12.
# For local dev, generate a self-signed one:
#   cd infra && bash scripts/generate-documenso-cert.sh
# The passphrase below must match what the script wrote.
DOCUMENSO_CERT_PASSPHRASE=documenso

# ===========================================================================
# Phase B — Webhook glue
# ===========================================================================

# Generate inside Twenty UI: Settings → Developers → API Keys. Required for
# documenso-webhook and calcom-webhook to write back into Twenty.
TWENTY_API_KEY=

# Optional HMAC secrets used to verify incoming webhooks. Generate with
# openssl rand -hex 32 and paste the same value in Documenso/Cal.com webhook
# settings. Leave blank to disable verification (NOT recommended).
DOCUMENSO_WEBHOOK_SECRET=
CALCOM_WEBHOOK_SECRET=
