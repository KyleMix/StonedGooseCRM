{
  "name": "stoned-goose-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Stoned Goose Productions — local-first business operations hub (CRM, pipeline, jobs, finance).",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "prisma migrate deploy && tsx prisma/seed.ts",
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "test": "node --import tsx --test src/lib/finance.test.ts src/lib/jobs.test.ts src/lib/utils.test.ts",
    "typecheck": "tsc --noEmit",
    "db:reset": "prisma migrate reset --force && tsx prisma/seed.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "clsx": "2.1.1",
    "lucide-react": "0.460.0",
    "next": "^16.2.6",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.13.3",
    "tailwind-merge": "2.5.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.15",
    "tsx": "^4.22.3",
    "typescript": "5.6.3"
  }
}
