// Stoned Goose Hub — data model (Phase 1 entities).
//
// Local-first design: SQLite file via Prisma. To move to a hosted DB later
// (Turso/libSQL or Postgres) for multi-device use, change `provider` + the
// DATABASE_URL in .env, then run `prisma migrate deploy`. The app code talks
// to Prisma only (see src/lib/db.ts), so the swap stays small.
//
// SQLite note: SQLite has no native enum type. We model enums as String
// columns and constrain the allowed values in code (see src/lib/constants.ts)
// and in form validation. This keeps the schema portable to Postgres later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

model Contact {
  id            String   @id @default(cuid())
  name          String
  org           String? // company / organization
  role          String?
  type          String // Client | Lead | Venue | Vendor | Sponsor | Contractor | Comedian/Talent | Crew | Media | Referral
  email         String?
  phone         String?
  location      String?
  website       String? // website / social
  lastContacted DateTime?
  nextFollowUp  DateTime?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  pipelineEntries PipelineEntry[]
  clientJobs      Job[]           @relation("JobClient")
  venueJobs       Job[]           @relation("JobVenue")
  crewAssignments JobCrew[]
  revenueEntries  RevenueEntry[]
  quotes          Quote[]
}

// ---------------------------------------------------------------------------
// Sales pipeline
// ---------------------------------------------------------------------------

model PipelineEntry {
  id            String   @id @default(cuid())
  // Each lead links to a Contact (the company/person being pursued).
  contactId     String
  contact       Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  stage         String // one of the 11 pipeline stages (see constants.ts)
  clientType    String? // Comedy venue | Brewery | Festival | Corporate | ...
  serviceNeeded String?
  estValue      Float?
  lastContact   DateTime?
  nextFollowUp  DateTime?
  notes         String?
  // Sort order within a stage column on the kanban board.
  position      Int      @default(0)

  // When a lead converts to a booked job, we link it here.
  jobId String? @unique
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Jobs / Events
// ---------------------------------------------------------------------------

model Job {
  id        String  @id @default(cuid())
  title     String // short label, e.g. "Craft Kitchen Comedy Night"
  clientId  String?
  client    Contact? @relation("JobClient", fields: [clientId], references: [id], onDelete: SetNull)
  venueId   String?
  venue     Contact? @relation("JobVenue", fields: [venueId], references: [id], onDelete: SetNull)
  date      DateTime?
  eventType String? // Comedy venue | Brewery | Corporate | Wedding | Live music | ...
  packageId String?
  package   Service? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  // Status. BUSINESS RULE (§5.4): a job may only be "Booked" when BOTH
  // contractSigned AND depositCleared are true. Enforced in src/lib/jobs.ts.
  status         String  @default("Inquiry") // Inquiry | Proposal | Booked | In Prep | Completed | Delivered | Archived
  contractSigned Boolean @default(false)
  depositCleared Boolean @default(false)

  agreedPrice  Float?
  deliverables String?
  deliveryDate DateTime?
  runOfShow    String? // free-text run-of-show notes
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  crew          JobCrew[]
  tasks         Task[]
  gearItems     GearChecklistItem[]
  revenue       RevenueEntry[]
  pipelineEntry PipelineEntry?
}

// Join table: which crew (Contacts) are assigned to a Job.
model JobCrew {
  id        String  @id @default(cuid())
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  roleNote  String? // role on this job, e.g. "Audio", "Director/Switch"

  @@unique([jobId, contactId])
}

// A simple per-job gear checklist line (the "pack list").
model GearChecklistItem {
  id      String  @id @default(cuid())
  jobId   String
  job     Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  system  String? // Cameras | Audio | PA | ...
  item    String
  qty     String? // kept as text ("set", "6", etc.) to match real pack lists
  packed  Boolean @default(false)
  notes   String?
  position Int     @default(0)
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

model Task {
  id       String    @id @default(cuid())
  title    String
  category String? // Admin | Sales | Finance | Marketing | Operations | Client | Equipment | Legal | Follow-up
  owner    String?
  dueDate  DateTime?
  priority String    @default("Med") // High | Med | Low
  status   String    @default("Not started") // Not started | In progress | Waiting | Blocked | Done
  notes    String?

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Finance
// ---------------------------------------------------------------------------

// One-time / capital costs. lineTotal is computed (qty * unitPrice) in code.
model CapitalItem {
  id              String  @id @default(cuid())
  item            String
  category        String?
  qty             Float   @default(1)
  unitPrice       Float? // nullable: blank is allowed, never invent a price (§5.3)
  priceConfidence String  @default("Quote needed") // Confirmed | Approximate | Placeholder | Quote needed
  notes           String? // notes / source
  position        Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Recurring monthly operating costs.
model OpexItem {
  id            String  @id @default(cuid())
  item          String
  category      String?
  monthlyAmount Float? // nullable: blank until a real figure exists (§5.6)
  basis         String  @default("Needs figure") // Known | Placeholder | Needs figure
  notes         String?
  position      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A single app-wide settings row (id = "singleton") for global finance knobs.
model Settings {
  id              String @id @default("singleton")
  contingencyRate Float  @default(0.12)
  runwayMonths    Int    @default(6)
}

model RevenueEntry {
  id              String   @id @default(cuid())
  date            DateTime?
  clientId        String?
  client          Contact? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  service         String?
  invoiceAmount   Float?
  depositReceived Float    @default(0)
  // balanceDue is computed (invoiceAmount - depositReceived), never hand-entered (§5.5).
  paymentStatus   String   @default("Unpaid") // Unpaid | Deposit paid | Paid in full | Overdue
  profitEstimate  Float?
  notes           String?

  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExpenseEntry {
  id               String   @id @default(cuid())
  date             DateTime?
  vendor           String?
  category         String?
  amount           Float?
  oneTimeOrRecurring String @default("One-time") // One-time | Recurring
  receiptSaved     Boolean  @default(false)
  taxDeductible    Boolean  @default(false)
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Services / Packages (placeholder prices allowed; nullable until set)
// ---------------------------------------------------------------------------

model Service {
  id          String  @id @default(cuid())
  name        String
  description String?
  inclusions  String?
  basePrice   Float? // nullable until priced
  notes       String?
  position    Int     @default(0)

  jobs Job[]
}

// ---------------------------------------------------------------------------
// Phase 2
// ---------------------------------------------------------------------------

// Quote tracker — prices that still need locking. status uses the same
// price-confidence flags as capital items (Confirmed | Approximate |
// Placeholder | Quote needed). vendor optionally links to a Vendor contact.
model Quote {
  id        String  @id @default(cuid())
  item      String
  vendorId  String?
  vendor    Contact? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  vendorName String? // free-text fallback when no Contact is linked
  price     Float? // nullable: never invent a number (§5.3)
  status    String  @default("Quote needed") // Confirmed | Approximate | Placeholder | Quote needed
  dateQuoted DateTime?
  link      String?
  notes     String?
  position  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Equipment / Asset inventory.
model Asset {
  id                  String   @id @default(cuid())
  item                String
  category            String?
  brandModel          String?
  serialNumber        String?
  purchaseDate        DateTime?
  purchasePrice       Float?
  warranty            String?
  storageLocation     String?
  condition           String?  @default("Good") // New | Good | Fair | Needs repair | Retired
  maintenanceSchedule String?
  qty                 Int      @default(1)
  notes               String?
  position            Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Content tracker — clips, posts, videos.
model ContentItem {
  id               String   @id @default(cuid())
  title            String
  platform         String? // YouTube | Instagram | TikTok | X | Facebook | Other
  format           String? // Clip | Long-form | Reel | Short | Post | Thumbnail
  status           String   @default("Idea") // Idea | Scripted | Filming | Editing | Scheduled | Published | Repurposed
  owner            String?
  dueDate          DateTime?
  publishDate      DateTime?
  hook             String?
  thumbnailIdea    String?
  caption          String?
  link             String?
  performanceNotes String?
  position         Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Weekly review — one record per week.
model WeeklyReview {
  id              String   @id @default(cuid())
  weekOf          DateTime // the Monday (or chosen start) of the week
  wins            String?
  problems        String?
  moneyStatus     String?
  priorities      String?
  risks           String?
  decisionsNeeded String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([weekOf])
}
