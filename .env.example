# Copy this file to `.env` (which is git-ignored), then run `npm install && npm run dev`.
#
# Local SQLite database file. Your data lives in this single file on disk
# (prisma/dev.db). To back it up, copy that file somewhere safe.
# To later move to a hosted DB (Turso/libSQL or Postgres), change this URL
# and the `provider` in prisma/schema.prisma — see the README.
DATABASE_URL="file:./dev.db"
